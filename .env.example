# 웨더핏 서울 — 환경변수
# 셋 다 없어도 서비스는 동작한다. 없으면 공개 카탈로그 + 기본 날씨 + 규칙 기반으로 떨어지고,
# 어느 쪽이 쓰였는지는 /api/health 와 화면 상단에 항상 표시된다.

# 비짓서울 API — https://api.visitseoul.net > API 키 발급 및 관리
# 없으면 공개 카탈로그(api.visitseoul.net/contents/standard)를 소스로 쓴다.
VISITSEOUL_API_KEY=

# 기상청 단기예보 — https://www.data.go.kr (기상청_단기예보 조회서비스, 디코딩된 일반 인증키)
# 없으면 맑음 21°C 기본값으로 판정한다.
KMA_API_KEY=

# LLM — 운영시간 정규화·실내외 태깅·코스 설명
# 없으면 weatherfit/normalize.py 의 규칙 기반 결과를 쓴다.
ANTHROPIC_API_KEY=
WEATHERFIT_MODEL=claude-sonnet-5

# 서버 포트
PORT=8020
