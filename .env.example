# 웨더핏 서울 — 환경변수
#
# 하나도 없어도 서비스는 완전히 동작한다. 없으면 공개 카탈로그·기본 날씨·
# 직선거리 추정·규칙 기반 응답으로 떨어지고, 어느 쪽이 쓰였는지는
# /api/health 와 화면에 항상 표시된다.

# ── 관광 콘텐츠 ────────────────────────────────────────────
# 비짓서울 API — https://api.visitseoul.net > API 키 발급 및 관리
# 없으면 공개 카탈로그(api.visitseoul.net/contents/standard)를 소스로 쓴다.
VISITSEOUL_API_KEY=

# ── 날씨 ──────────────────────────────────────────────────
# 기상청 초단기실황(getUltraSrtNcst). 없으면 맑음 21°C 기본값으로 판정한다.
# 두 곳에서 같은 오퍼레이션을 준다. 어느 쪽 키든 넣으면 알아서 맞춘다.
#   기상청 API 허브    https://apihub.kma.go.kr        (authKey)
#   공공데이터포털      https://www.data.go.kr          (serviceKey, 디코딩 키)
# 포털에서 신청할 항목: "동네예보(단기예보, 초단기예보, 실황) 격자자료"
KMA_API_KEY=

# ── 경로 소요시간 ──────────────────────────────────────────
# 셋 다 없으면 직선거리 × 우회율로 추정하고 '추정'으로 표시한다.

# 도보 — TMAP 보행자 경로 (SK open API)
# https://openapi.sk.com > Tmap API  무료 1,000회/일
# 없어도 공개 OSRM 보행 프로파일로 실측한다. 다만 공개 서버라 요청이
# 몰리면 스로틀이 걸리므로, 실제 서비스에는 TMAP 키나 자체 OSRM이 필요하다.
TMAP_APP_KEY=

# 대중교통 — ODsay LAB (국내 대중교통 환승경로를 주는 사실상 유일한 공개 API)
# https://lab.odsay.com  무료 1,000회/일
# 없으면 직선거리 ÷ 평균속도로 추정하고 화면에 '추정'으로 표시한다.
# 대안: 국토부 TAGO 대중교통 환승경로 (data.go.kr) — 전국 단위, 응답이 느리다
ODSAY_API_KEY=

# 자동차 — 네이버 클라우드 플랫폼 Directions 5
# https://www.ncloud.com > Maps
# (네이버 지도 API에는 보행자·대중교통 경로가 공개돼 있지 않아 자동차만 맡는다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── LLM ───────────────────────────────────────────────────
# 에이전트의 답변 문장을 쓴다. 도구는 키가 없어도 그대로 돌고, 문장만
# 템플릿이 된다. 어느 쪽이 쓰였는지는 /api/health의 llm_provider에 실린다.
# 둘 다 있으면 Anthropic이 먼저다.
ANTHROPIC_API_KEY=
WEATHERFIT_MODEL=claude-sonnet-5

# 또는 Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
WEATHERFIT_GEMINI_MODEL=gemini-3.6-flash

# ── 서버 ──────────────────────────────────────────────────
PORT=8020

# ── 원격탐사 ──────────────────────────────────────────────
# 위성 지표면온도·NDVI는 키가 필요 없다.
# Microsoft Planetary Computer의 STAC과 SAS 토큰이 모두 공개다.
#   python -m weatherfit.remote build
